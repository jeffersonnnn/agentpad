# AgentPad nginx reverse proxy -> the Next.js app (agentpad-web on 127.0.0.1:3000).
# Install:
#   sudo cp deploy/nginx/agentpad.conf.example /etc/nginx/sites-available/agentpad
#   sudo ln -s /etc/nginx/sites-available/agentpad /etc/nginx/sites-enabled/agentpad
#   sudo nginx -t && sudo systemctl reload nginx
# Then add TLS with certbot:  sudo certbot --nginx -d YOUR_DOMAIN
# certbot rewrites this file to listen on 443 and redirect 80 -> 443.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;   # e.g. agentpad.xyz  (or the VPS IP for a first smoke test)

    # Let the Next.js app set caching for its static assets.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    client_max_body_size 12m;   # token-logo uploads (IPFS pin) go through the app
}
